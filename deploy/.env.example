# Database
POSTGRES_USER=stockcentral
POSTGRES_PASSWORD=change_me_to_a_very_strong_password
POSTGRES_DB=stockcentral

# CORS — comma-separated list of allowed origins
# If using Cloudflare proxy, use https://stocks.tribalorigin.com,https://finanao.com
# If using raw IP, use http://YOUR_SERVER_IP
CORS_ORIGIN=https://stocks.tribalorigin.com,https://finanao.com

# Optional: FRED API key for US & Japan sovereign bond yields
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
